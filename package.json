{
  "name": "clip-queue",
  "version": "3.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./paraglide && nuxt typecheck",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "format": "oxfmt .",
    "lint": "oxfmt --check . && eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "translations:update": "pnpm dlx @inlang/cli machine translate --project ./project.inlang && pnpm format",
    "dependencies:update": "pnpm self-update && pnpm dlx nuxt upgrade --dedupe && pnpm up --latest",
    "commitlint": "commitlint --edit",
    "changeset": "changeset"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "1.0.3",
    "@tanstack/vue-table": "^8.21.3",
    "@tmi.js/chat": "^0.8.0",
    "@videojs/hlsjs-video": "10.1.0",
    "@videojs/html": "10.1.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@inlang/paraglide-js": "2.29.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@pinia/testing": "^2.0.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.14.0"
}
