{
  "name": "clip-queue",
  "version": "3.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./paraglide && nuxt typecheck",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "format": "oxfmt .",
    "lint": "oxfmt --check . && eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "translations:update": "pnpm dlx @inlang/cli machine translate --project ./project.inlang && pnpm format",
    "dependencies:update": "pnpm self-update && pnpm dlx nuxt upgrade --dedupe && pnpm up --latest",
    "commitlint": "commitlint --edit",
    "changeset": "changeset"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "1.0.2",
    "@tanstack/vue-table": "^8.21.3",
    "@tmi.js/chat": "^0.8.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "video.js": "^8.24.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@iconify-json/lucide": "^1.2.125",
    "@iconify-json/simple-icons": "^1.2.93",
    "@inlang/paraglide-js": "2.24.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "4.1.0",
    "@pinia/testing": "^2.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.23.0"
}
